# ============================================================
# Calendário SDR — V4 Company
# Copie este arquivo para ".env.local" e preencha os valores.
# ============================================================

# --- Google Cloud Console (obrigatório) ---
# Console: https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth 2.0" > Aplicativo da Web
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL base da aplicação (mude quando publicar, ex.: https://agenda.suaempresa.com.br)
APP_BASE_URL=http://localhost:3000

# --- Segurança ---
# Código de acesso que o SDR digita para usar o sistema.
# Deixe vazio para desativar a proteção (não recomendado).
APP_ACCESS_CODE=v4sdr2026

# --- Opcionais ---
# E-mail do SDR/freelancer: será convidado automaticamente em toda reunião.
SDR_EMAIL=

# true = busca o link da gravação (Drive) depois que alguém grava a call
# manualmente. NÃO liga gravação automática — o Google Meet não permite isso
# via API. Requer "Google Meet API" ativa no Cloud Console; reconecte a conta
# Google após ativar.
MEET_SHOW_RECORDINGS=false

# Fuso horário dos agendamentos
TIMEZONE=America/Sao_Paulo
